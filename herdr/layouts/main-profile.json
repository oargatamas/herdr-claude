{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "chrome-mechanicus"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-profile"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "auspex",
              "type": "block",
              "content": {
                "mod": "auspex"
              },
              "size": {
                "weight": 1.6
              },
              "min": 140
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "servitors-mechanicus"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "chrome-mechanicus",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 300
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "border": {
        "width": 1,
        "color": "input"
      }
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-profile"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-mechanicus"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": {
                    "image": "backgrounds/mechanicus-emblem-backdrop-4.png",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 2,
                    "color": "accent"
                  },
                  "radius": 0,
                  "gap": 6,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "status-mechanicus"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "gradient": [
      "#0b1a09",
      "#020302"
    ],
    "angle": 180
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "input"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "mechanicus",
  "ui_font": "Share Tech Mono",
  "font": "JetBrains Mono",
  "font_weight": 500,
  "terminal_opacity": 0.2
}
